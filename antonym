from pymongo import MongoClient
from kiwipiepy import Kiwi
import pandas as pd

def get_db_collections(mongo_uri):
    try:
        client = MongoClient(mongo_uri, tls=True, tlsAllowInvalidCertificates=True)
        print("get_db_collections 연결성공")
    except Exception as e:
        print(f"오류 발생: {e}")
        return None  # 오류 발생 시 None 반환

    DB_collections = {}
    database_names = client.list_database_names()

    for db_name in database_names:
        db = client[db_name]
        collection_names = db.list_collection_names()
        DB_collections[db_name] = collection_names

    return DB_collections

def get_comments(mongo_uri):
    try:
        client = MongoClient(mongo_uri, tls=True, tlsAllowInvalidCertificates=True)
        print("get_comments 연결성공")
    except Exception as e:
        print(f"오류 발생: {e}")
        return None  # 오류 발생 시 None 반환

    kiwi = Kiwi()
    V_counter = {}
    DB_collection = get_db_collections(mongo_uri)

    if DB_collection is None:
        return V_counter  # DB 컬렉션을 가져오지 못했을 경우 빈 사전 반환

    for db_name, collection_names in DB_collection.items():
        db = client[db_name]
        for collection_name in collection_names:
            collection = db[collection_name]
            comments = collection.find()

            for comment in comments:
                text = comment.get('text')
                if not text:
                    continue

                sentences = kiwi.split_into_sents(text, return_tokens=True)
                for i, sentence in enumerate(sentences, start=1):
                    for token in sentence.tokens:
                        if token.tag.startswith("VV") or token.tag.startswith("VA"):
                            if token.form in V_counter:
                                V_counter[token.form] += 1
                            else:
                                V_counter[token.form] = 1

    return V_counter

def create_antonym_list(verbs, antonym_dict):
    antonyms = []
    for verb in verbs:
        if verb in antonym_dict:
            antonyms.append((verb, antonym_dict[verb]))
    return antonyms

def save_to_excel(antonyms, file_name="antonyms.xlsx"):
    df = pd.DataFrame(antonyms, columns=["Word", "Antonym"])
    df.to_excel(file_name, index=False)
    print(f"엑셀 파일로 저장되었습니다: {file_name}")

